# App Settings
APP_NAME="PDF Extraction Backend"
DEBUG=false

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=temp_uploads

# OCR Settings
TESSERACT_CMD=  # Leave empty for auto-detect, or specify path like /usr/bin/tesseract
OCR_LANGUAGE=eng  # Tesseract language code (eng, fra, deu, etc.)

# API Settings
API_V1_PREFIX=/api/v1

# Data services (Docker Compose service names; use localhost outside Docker)
MONGODB_URI=mongodb://mongodb:27017/pdf_benchmark
REDIS_URL=redis://redis:6379/0
MAX_PDF_PAGES=100
MAX_ACTIVE_UPLOAD_JOBS=20
MAX_ACTIVE_UPLOAD_JOBS_PER_IP=2
MAX_ACTIVE_CORPUS_RUNS=1
PRIVATE_JOB_RETENTION_HOURS=24
WORKER_HEARTBEAT_SECONDS=30
DISPATCHER_HEARTBEAT_SECONDS=15
WORK_LEASE_SECONDS=120
WORK_TIMEOUT_SECONDS=90
QUEUE_MAX_BYTES=1073741824
WORKER_ID=worker-1
